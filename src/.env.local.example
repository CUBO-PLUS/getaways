# Configure DATABASE_URL in .env, shared by the host and Compose.
# Anthropic API key (server only).
ANTHROPIC_API_KEY=
# S3_ENDPOINT for a Node process on the host (inside Compose it is http://rustfs:9000).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=blog-media
BLOG_SESSION_SECRET=
BLOG_APP_ORIGIN=http://localhost:3000
# Guest accounts reuse the secret/origin, but not staff sessions or permissions.
# Local-only until account recovery is defined; use the exact browser origin/port.
# Use the restricted application identity, never RustFS root credentials.
S3_ACCESS_KEY_ID=blog-app-dev
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret

# Opt in explicitly; never set this for production/mainnet. Use a remote HTTPS
# origin, or an explicitly verified optional local stack. No Docker is needed for HTTPS.
# These credentials are server-only. Use only the scopes documented in pagos/infraestructura-local.md.
# Only btcpay-testnet is supported; empty/obsolete values disable checkout (no mock fallback).
PAYMENT_PROVIDER=
BTCPAY_NETWORK=testnet
BTCPAY_API_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
# Remote HTTPS only: first native SegWit testnet receive address (0/0), independently
# compared with the operator wallet. Requires read-only btcpay.store.canviewwallet.
BTCPAY_EXPECTED_WALLET_ADDRESS=
BTCPAY_DEPLOYMENT_PROOF_PATH=
BTCPAY_DEPLOYMENT_PROOF_KEY=
