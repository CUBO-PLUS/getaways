        "description": "create table \"GuestAccount\"",
        "sql": "CREATE TABLE \"public\".\"GuestAccount\" (\n  \"active\" bool DEFAULT true NOT NULL,\n  \"authVersion\" int4 DEFAULT 1 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"email\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"name\" text NOT NULL,\n  \"passwordHash\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"guest_account_auth_version_positive_e4ec2ac8\" CHECK (\"authVersion\" > 0),\n  CONSTRAINT \"guest_account_email_normalized_32441ce4\" CHECK (lower(btrim(email)) = email AND email <> ''),\n  CONSTRAINT \"guest_account_name_nonempty_00a4830a\" CHECK (btrim(name) <> '')\n)",
        "params": []
      }
    ],
