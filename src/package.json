{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "prisma contract emit",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "blog:dry-run": "node scripts/blog-import-dry-run.mjs",
    "blog:convert": "node --experimental-strip-types scripts/blog-import-convert.mts",
    "blog:approval-template": "node --conditions=react-server --experimental-strip-types scripts/blog-import-approval-template.mts",
    "blog:import": "node --conditions=react-server --experimental-strip-types scripts/blog-import.mts",
    "listings:import": "node --conditions=react-server --experimental-strip-types scripts/listings-import.mts",
    "bookings:import": "node --conditions=react-server --experimental-strip-types scripts/bookings-import.mts",
    "admin:user": "node --conditions=react-server --experimental-strip-types scripts/admin-user.mts",
    "test:db": "NODE_ENV=development PRISMA_TEST_DATABASE=1 vitest run infrastructure/prisma/_test_/db.test.ts",
    "db:generate": "prisma contract emit",
    "db:init": "prisma db init",
    "db:check": "prisma db verify",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@next/env": "16.4.2",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/static-renderer": "^3.32.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-phone-number-input": "^3.4.17",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.0.1",
    "prisma": "8.0.0-rc.23",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
