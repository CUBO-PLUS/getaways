# Local development database from compose.dev.yaml (app running on the host).
# Match the PostgreSQL credentials and published port if you override them.
DATABASE_URL=postgresql://gateways:gateways_dev@127.0.0.1:5432/gateways
# S3_ENDPOINT for a Node process on the host (inside Compose it is http://rustfs:9000).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=blog-media
BLOG_ADMIN_PASSWORD_HASH=
BLOG_SESSION_SECRET=
BLOG_APP_ORIGIN=http://localhost:3000
# Use the restricted application identity, never RustFS root credentials.
S3_ACCESS_KEY_ID=blog-app-dev
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
