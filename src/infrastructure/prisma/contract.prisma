// use prisma-8

model ReferralCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ReferralAttribution {
  id           Int      @id @default(autoincrement())
  bookingId    Int      @unique
  referralCode String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

model BlogPost {
  id                    Int                 @id @default(autoincrement())
  slug                  String              @unique
  title                 String
  excerpt               String
  document              Jsonb
  documentSchemaVersion Int
  coverMediaId          Int?
  coverAlt              String?
  seoTitle              String?
  seoDescription        String?
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             temporal.updatedAt()
  firstPublishedAt      DateTime?
  coverMedia            MediaAsset?         @relation(fields: [coverMediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publication           BlogPublication?
  categories            BlogPostCategory[]

  @@index([coverMediaId])
}

model BlogPublication {
  postId                Int                         @id
  title                 String
  excerpt               String
  document              Jsonb
  documentSchemaVersion Int
  coverMediaId          Int?
  coverAlt              String?
  seoTitle              String?
  seoDescription        String?
  publishedAt           DateTime                    @default(now())
  updatedAt             temporal.updatedAt()
  post                  BlogPost                    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  coverMedia            MediaAsset?                 @relation(fields: [coverMediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories            BlogPublicationCategory[]

  @@index([publishedAt])
  @@index([coverMediaId])
}

model MediaAsset {
  id           Int               @id @default(autoincrement())
  legacyMediaId BigInt?          @unique
  objectKey    String            @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  width        Int
  height       Int
  defaultAlt   String?
  createdAt    DateTime          @default(now())
  draftCovers  BlogPost[]
  liveCovers   BlogPublication[]
  listingCovers Listing[]
  listings      ListingMedia[]
}

model BlogCategory {
  id            Int                         @id @default(autoincrement())
  name          String
  slug          String                      @unique
  posts         BlogPostCategory[]
  publications  BlogPublicationCategory[]
  slugAliases   BlogCategorySlugAlias[]
}

model BlogCategorySlugAlias {
  slug       String       @id
  categoryId Int
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([categoryId])
}

model BlogPostCategory {
  postId     Int
  categoryId Int
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model BlogPublicationCategory {
  publicationPostId Int
  categoryId        Int
  publication       BlogPublication @relation(fields: [publicationPostId], references: [postId], onDelete: Cascade, onUpdate: Restrict)
  category          BlogCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([publicationPostId, categoryId])
  @@index([categoryId])
}

model BlogImportMapping {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  targetKind  String
  targetId    Int
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([source, sourceId])
  @@unique([targetKind, targetId])
}

enum AdminRole {
  @@type("pg/text@1")
  ADMIN = "ADMIN"
  EDITOR = "EDITOR"
  BOOKING_MANAGER = "BOOKING_MANAGER"
}

model AdminUser {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  name              String
  passwordHash      String
  role              AdminRole @default(EDITOR)
  active            Boolean  @default(true)
  authVersion       Int      @default(1)
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAt()
  deactivatedAt     DateTime?

  @@check(expression: sql`email = lower(btrim(email)) AND email <> ''`, name: "admin_user_email_normalized")
  @@check(expression: sql`btrim(name) <> ''`, name: "admin_user_name_nonempty")
  @@check(expression: sql`"authVersion" > 0`, name: "admin_user_auth_version_positive")
}

model AdminLoginThrottle {
  key          String   @id
  attempts     Int
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

model Listing {
  id                    Int                     @id @default(autoincrement())
  wpId                  BigInt?                 @unique
  slug                  String                  @unique
  title                 String
  contentHtml           String
  attributes            Jsonb
  active                Boolean                 @default(false)
  archivedAt            DateTime?
  coverMediaId          Int?
  version               Int                     @default(1)
  createdAt             DateTime                @default(now())
  updatedAt             temporal.updatedAt()
  pricePerNightCents    Int?
  cleaningFeeCents      Int?
  extraGuestFeeCents    Int?
  petFeeCents           Int?
  ivaBasisPoints        Int?
  tourismBasisPoints    Int?
  maxGuests             Int?
  baseGuests            Int?
  petsAllowed           Boolean?
  minStayNights         Int?
  checkInSeconds        Int?
  checkOutSeconds       Int?
  coverMedia            MediaAsset?             @relation(fields: [coverMediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terms                 ListingTermAssignment[]
  media                 ListingMedia[]

  @@index([coverMediaId])
  @@check(expression: sql`"version" > 0`, name: "listing_version_positive")
  @@check(expression: sql`("pricePerNightCents" IS NULL OR "pricePerNightCents" >= 0) AND ("cleaningFeeCents" IS NULL OR "cleaningFeeCents" >= 0) AND ("extraGuestFeeCents" IS NULL OR "extraGuestFeeCents" >= 0) AND ("petFeeCents" IS NULL OR "petFeeCents" >= 0)`, name: "listing_money_nonnegative")
  @@check(expression: sql`("ivaBasisPoints" IS NULL OR "ivaBasisPoints" BETWEEN 0 AND 10000) AND ("tourismBasisPoints" IS NULL OR "tourismBasisPoints" BETWEEN 0 AND 10000)`, name: "listing_tax_basis_points_range")
  @@check(expression: sql`("maxGuests" IS NULL OR "maxGuests" > 0) AND ("baseGuests" IS NULL OR ("baseGuests" > 0 AND "maxGuests" IS NOT NULL AND "baseGuests" <= "maxGuests"))`, name: "listing_guests_valid")
  @@check(expression: sql`NOT active OR ("pricePerNightCents" IS NOT NULL AND "pricePerNightCents" > 0 AND "maxGuests" IS NOT NULL AND "maxGuests" > 0)`, name: "listing_active_bookable")
  @@check(expression: sql`"minStayNights" IS NULL OR "minStayNights" > 0`, name: "listing_min_stay_positive")
  @@check(expression: sql`("checkInSeconds" IS NULL OR "checkInSeconds" BETWEEN 0 AND 86399) AND ("checkOutSeconds" IS NULL OR "checkOutSeconds" BETWEEN 0 AND 86399)`, name: "listing_time_seconds_range")
  @@check(expression: sql`jsonb_typeof(attributes) = 'object' AND NOT (attributes ?| ARRAY['price', 'cleaning_fee', 'extra_guest_fee', 'pet_fee', 'iva', 'tourism_tax', 'pricePerNightCents', 'cleaningFeeCents', 'extraGuestFeeCents', 'petFeeCents', 'ivaBasisPoints', 'tourismBasisPoints'])`, name: "listing_attributes_descriptive")
}

model Booking {
  id                     Int       @id @default(autoincrement())
  listingId              Int
  guestAccountId         Int?
  checkIn                DateString
  checkOut               DateString
  nights                 Int
  guestName              String
  guestEmail             String
  guestPhone             String?
  guestNotes             String?
  guests                 Int?
  currency               String    @default("USD")
  pricePerNightCents     BigInt
  cleaningFeeCents       BigInt
  petFeeCents            BigInt
  extraGuestFeeCents     BigInt
  discountCents          BigInt
  taxCents               BigInt
  totalAmountCents       BigInt
  couponCode             String?
  status                 String
  checkoutSessionId      String?   @unique
  paymentReference       String?   @unique
  adminNotes             String?
  pricingSnapshot        Jsonb?
  pricingReviewRequired  Boolean   @default(false)
  agreedListingTitle     String
  version                Int       @default(1)
  cancelledAt            DateTime?
  cancellationReason     String?
  cancelledBy            String?
  paymentReviewRequired  Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              temporal.updatedAt()
  listing                Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guestAccount           GuestAccount? @relation(fields: [guestAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentAttempt         PaymentAttempt?

  @@index([listingId, status, checkIn])
  @@index([createdAt])
  @@index([guestAccountId])
  @@check(expression: sql`nights > 0 AND "checkIn" < "checkOut"`, name: "booking_stay_valid")
  @@check(expression: sql`"guestName" <> '' AND "guestEmail" <> '' AND "agreedListingTitle" <> ''`, name: "booking_guest_fields_nonempty")
  @@check(expression: sql`"pricePerNightCents" >= 0 AND "cleaningFeeCents" >= 0 AND "petFeeCents" >= 0 AND "extraGuestFeeCents" >= 0 AND "discountCents" >= 0 AND "taxCents" >= 0 AND "totalAmountCents" >= 0`, name: "booking_amounts_nonnegative")
  @@check(expression: sql`"guests" IS NULL OR "guests" > 0`, name: "booking_guests_positive")
  @@check(expression: sql`status IN ('pending_payment', 'confirmed', 'cancelled')`, name: "booking_status_valid")
  @@check(expression: sql`currency = 'USD'`, name: "booking_currency_usd")
  @@check(expression: sql`version > 0`, name: "booking_version_positive")
  @@check(expression: sql`("pricingSnapshot" IS NULL) = "pricingReviewRequired"`, name: "booking_pricing_review_consistent")
}

model PaymentAttempt {
  id                    String   @id
  bookingId             Int      @unique
  provider              String
  storeId               String
  network               String
  realTotalCents        BigInt
  testAmountCents       Int
  invoiceId             String?  @unique
  checkoutLink          String?
  btcDestination        String?
  btcAmount             String?
  status                String
  reviewReason          String?
  createdAt             DateTime @default(now())
  updatedAt             temporal.updatedAt()
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt])
  @@check(expression: sql`"realTotalCents" > 0 AND "testAmountCents" IN (1, 100)`, name: "payment_attempt_amounts_valid")
  @@check(expression: sql`network = 'testnet'`, name: "payment_attempt_testnet_only")
}

model GuestAccount {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  authVersion  Int       @default(1)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()
  bookings     Booking[]

  @@check(expression: sql`"authVersion" > 0`, name: "guest_account_auth_version_positive")
  @@check(expression: sql`lower(btrim(email)) = email AND email <> ''`, name: "guest_account_email_normalized")
  @@check(expression: sql`btrim(name) <> ''`, name: "guest_account_name_nonempty")
  @@check(expression: sql`"phone" IS NULL OR btrim("phone") <> ''`, name: "guest_account_phone_nonempty")
}

model ListingTerm {
  id          Int                     @id @default(autoincrement())
  wpId        BigInt?
  taxonomy    String
  slug        String
  name        String
  assignments ListingTermAssignment[]
  categorySlugAliases ListingCategorySlugAlias[]

  @@unique([taxonomy, slug])
  @@unique([id, taxonomy])
}

model ListingCategorySlugAlias {
  slug       String      @id
  categoryId Int
  taxonomy   String      @default("hp_listing_category")
  category   ListingTerm @relation(fields: [categoryId, taxonomy], references: [id, taxonomy], onDelete: Cascade, onUpdate: Restrict)

  @@index([categoryId])
  @@check(expression: sql`taxonomy = 'hp_listing_category'`, name: "listing_category_alias_taxonomy")
}

model ListingTermAssignment {
  listingId Int
  termId    Int
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  term      ListingTerm @relation(fields: [termId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([listingId, termId])
  @@index([termId])
}

model ListingMedia {
  listingId Int
  mediaId   Int
  position  Int
  alt       String?
  roomGroup String?
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([listingId, mediaId])
  @@index([mediaId])
  @@index([listingId, position])
  @@check(expression: sql`position >= 0`, name: "listing_media_position_nonnegative")
}
